# Caddy config for the panel (static files from `yarn build`); replace localhost with your domain for HTTPS.
localhost {
    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @entry path /index.html /config.json /service-worker.js
    header @entry Cache-Control "no-cache"

    # Same-origin API (default apiUrl "/api"); Caddy streams server-sent events without buffering.
    # handle_path /api/* {
    #     reverse_proxy 127.0.0.1:3301
    # }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
